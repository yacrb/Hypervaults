# Generated locally by: uv run python manage.py up
# Development defaults are explicitly localhost-only. Never commit .env.
HV_MODE=development
HV_ORIGIN=http://127.0.0.1:8088
HV_MONGO_URI=mongodb://127.0.0.1:27018
HV_MONGO_DATABASE=hypervaults
HV_RPC_URL=http://127.0.0.1:8545
HV_CHAIN_ID=31337
HV_CONFIRMATIONS=1
HV_NOTE_ACTIVE_KEY=v1
# JSON mapping key IDs to base64-encoded random 32-byte keys, generated by setup.
HV_NOTE_KEYS='{"v1":"REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY"}'
# Production/testnet requires HTTPS, at least 6 confirmations and SMTP over TLS.
# HV_SMTP_HOST=smtp.example.invalid
# HV_SMTP_PORT=587
# HV_SMTP_USER=REPLACE_ME
# HV_SMTP_PASSWORD=REPLACE_ME
# HV_MAIL_FROM=security@example.invalid
